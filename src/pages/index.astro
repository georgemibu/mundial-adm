---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import Navbartop from "../components/Navbartop.astro";
import Navbarbottom from "../components/Navbarbottom.astro";
import Home from "../components/Home.astro";
import Desafio from "../components/Desafio.astro";
import Separador from "../components/Separador.astro";
import CuentaRegresiva from "../components/CuentaRegresiva.astro";
import ResumenReglamento from "../components/ResumenReglamento.astro";
import DesafioInterno from "../components/DesafioInterno.astro";
import FinalUniversitaria from "../components/FinalUniversitaria.astro";
import Congreso from "../components/Congreso.astro";
import Novedades from "../components/Novedades.astro";
import Edicion from "../components/Edicion.astro";
import Footer from "../components/Footer.astro";


