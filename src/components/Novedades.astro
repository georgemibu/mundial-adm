---
import NovedadesBox from "../components/NovedadesBox.astro";
---

<section id="novedades">
    <div class="titulo scroll-reveal">
        <h2>Novedades</h2>
    </div>

    <NovedadesBox />

    <div class="universidades scroll-reveal">
        <h2>¿Querés saber si tu Universidad esta participando?</h2>
        <div class="container-universidades">
            <div class="container-universidad">
                <img src="./Universidad1.png" alt="" />
                <h3>Universidad <br />Champagnat</h3>
            </div>
            <div class="container-universidad">
                <img src="./Universidad2.png" alt="" />
                <h3>UNCuyo</h3>
            </div>
            <div class="container-universidad">
                <img src="./Universidad3.png" alt="" />
                <h3>
                    Universidad <br />
                    Universitario <br />
                    de Ciencias <br />
                    Empresariales
                </h3>
            </div>
            <div class="container-universidad">
                <img src="./Universidad4.png" alt="" />
                <h3>
                    Universidad <br />
                    del <br />
                    Aconcagua
                </h3>
            </div>
            <div class="container-universidad">
                <img src="./Universidad5.png" alt="" />
                <h3>
                    Universidad <br />
                    Juan Agustín <br />
                    Maza
                </h3>
            </div>
            <div class="container-universidad">
                <img src="./Universidad6.png" alt="" />
                <h3>
                    Universidad <br />
                    Siglo 21
                </h3>
            </div>
            <div class="container-universidad">
                <img src="./Universidad7.png" alt="" />
                <h3>
                    Universidad <br />
                    Católica <br />
                    Santiago del <br />
                    Estero
                </h3>
            </div>
            <div class="container-universidad">
                <img src="./Universidad8.png" alt="" />
                <h3>
                    Instituto <br />
                    Tecnológico <br />
                    Universitario
                </h3>
            </div>
        </div>
    </div>
</section>



<style>
    .titulo h2 {
        text-align: center;
        margin-top: 60px;
        font-family: "Poppins", sans-serif;
        font-size: 40px;
        font-weight: 700;
    }
    .universidades {
        width: 100%;
    }
    .universidades h2 {
        font-family: "Poppins", sans-serif;
        font-weight: 700;
        font-size: 40px;
        text-align: center;
        margin-bottom: 40px;
    }
    .container-universidades {
        width: min(100%, 1120px);
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 140px), 1fr));
        justify-items: center;
        align-items: start;
        gap: 30px 24px;
    }

    .container-universidad {
        width: 100%;
        min-height: 209px;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        align-items: center;
    }
    .container-universidad img {
        width: 125px;
        height: 116px;
    }
    .container-universidad h3 {
        font-size: 16px;
    }

    @media (min-width: 641px) and (max-width: 1024px) {
        .titulo h2,
        .universidades h2 {
            font-size: 30px;
        }

        .container-universidades {
            grid-template-columns: repeat(auto-fit, minmax(min(100%, 130px), 1fr));
            gap: 24px 16px;
        }

        .container-universidad {
            min-height: 190px;
        }
    }

    @media (max-width: 640px) {
        .titulo h2 {
            font-size: 24px;
        }

        .universidades {
            padding: 0 16px;
        }

        .universidades h2 {
            font-size: 21px;
            margin-bottom: 24px;
        }

        .container-universidades {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 18px 12px;
        }

        .container-universidad {
            min-height: 160px;
        }

        .container-universidad img {
            width: 88px;
            height: 82px;
            object-fit: contain;
        }

        .container-universidad h3 {
            font-size: 13px;
            line-height: 1.25;
            text-align: center;
        }
    }
</style>
