---
import NovedadesBox from "../components/NovedadesBox.astro";
import { textosNovedades, universidades } from "../data/novedades";
---

<section id="novedades">
    <div class="titulo scroll-reveal">
        <h2>{textosNovedades.titulo}</h2>
    </div>

    <NovedadesBox />

    <div class="universidades scroll-reveal">
        <h2>{textosNovedades.tituloUniversidades}</h2>
        <div class="container-universidades">
            {universidades.map((universidad) => (
                <div class="container-universidad">
                    <img
                        src={universidad.imagen}
                        alt={universidad.textoAlternativo}
                    />
                    <h3>{universidad.nombre}</h3>
                </div>
            ))}
        </div>
    </div>
</section>

<style>
    .titulo h2 {
        text-align: center;
        margin-top: 60px;
        font-family: "Poppins", sans-serif;
        font-size: 40px;
        font-weight: 700;
    }
    .universidades {
        width: 100%;
    }
    .universidades h2 {
        font-family: "Poppins", sans-serif;
        font-weight: 700;
        font-size: 40px;
        text-align: center;
        margin-bottom: 40px;
    }
    .container-universidades {
        width: min(100%, 1120px);
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 140px), 1fr));
        justify-items: center;
        align-items: start;
        gap: 30px 24px;
    }

    .container-universidad {
        width: 100%;
        min-height: 209px;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        align-items: center;
    }
    .container-universidad img {
        width: 125px;
        height: 116px;
    }
    .container-universidad h3 {
        font-size: 16px;
        white-space: pre-line;
    }

    @media (min-width: 641px) and (max-width: 1024px) {
        .titulo h2,
        .universidades h2 {
            font-size: 30px;
        }

        .container-universidades {
            grid-template-columns: repeat(
                auto-fit,
                minmax(min(100%, 130px), 1fr)
            );
            gap: 24px 16px;
        }

        .container-universidad {
            min-height: 190px;
        }
    }

    @media (max-width: 640px) {
        .titulo h2 {
            font-size: 24px;
        }

        .universidades {
            padding: 0 16px;
        }

        .universidades h2 {
            font-size: 21px;
            margin-bottom: 24px;
        }

        .container-universidades {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 18px 12px;
        }

        .container-universidad {
            min-height: 160px;
        }

        .container-universidad img {
            width: 88px;
            height: 82px;
            object-fit: contain;
        }

        .container-universidad h3 {
            font-size: 13px;
            line-height: 1.25;
            text-align: center;
        }
    }
</style>
