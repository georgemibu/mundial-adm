        </div>
        <div class="contenedor-agenda">
            <img src="./homecalendario.png" alt="" />
            <h3>Gran Final - 5 de noviembre</h3>
        </div>
        <div class="contenedor-agenda">
            <img src="./homeevento.png" alt="" />
            <h3>CONAMERCO 2026</h3>
        </div>
        <img class="separador" src="./separador.png" alt="" class="separador" />
    </div>
