        </div>
    </div>
</section>

<div class="modal-backdrop" id="participa-modal" aria-hidden="true">
    <div
        class="modal-panel"
        role="dialog"
        aria-modal="true"
        aria-labelledby="participa-title"
    >
        <div class="modal-header">
            <button
                type="button"
                class="icon-button"
                aria-label="Volver"
                data-close-modal
            >
                <span aria-hidden="true">&#8592;</span>
            </button>
            <h3 id="participa-title">Participa</h3>
            <button
                type="button"
                class="icon-button close-button"
                aria-label="Cerrar formulario"
                data-close-modal
            >
                <span aria-hidden="true">&#215;</span>
            </button>
        </div>

        <div class="modal-step"></div>

        <form id="participa-form">
            <div class="field-group">
                <label for="nombre-apellido">Nombre y apellido</label>
                <input
                    id="nombre-apellido"
                    name="nombre-apellido"
                    type="text"
                    placeholder="Escribe"
                />
            </div>

            <div class="field-group">
                <label for="celular">Celular de contacto</label>
                <input
                    id="celular"
                    name="celular"
                    type="tel"
                    placeholder="Ej: +54 261 1234567"
                />
            </div>

            <div class="field-group">
                <label for="email">E-mail personal o de tu universidad</label>
                <input
                    id="email"
                    name="email"
                    type="email"
                    placeholder="Escribe"
                />
            </div>

            <div class="field-group">
                <label for="universidad">Nombre de la universidad</label>
                <input
                    id="universidad"
                    name="universidad"
                    type="text"
                    placeholder="Escribe"
                />
            </div>

            <div class="field-group">
                <label for="rol"
                    >¿Eres estudiante, docente o miembro directivo de la
                    universidad?</label
                >
                <select id="rol" name="rol">
                    <option value="">Seleccioná una opción</option>
                    <option value="estudiante">Estudiante</option>
                    <option value="docente">Docente</option>
                    <option value="directivo">Miembro directivo</option>
                </select>
            </div>

            <div class="field-group">
                <label for="pais">País</label>
                <input
                    id="pais"
                    name="pais"
                    type="text"
                    placeholder="Escribe"
                />
            </div>

            <div class="field-group">
                <label for="localidad">Localidad</label>
                <input
                    id="localidad"
                    name="localidad"
                    type="text"
                    placeholder="Escribe"
                />
            </div>

            <button type="submit" class="submit-btn">Enviar</button>
        </form>
    </div>
</div>

<div class="bottom">
    <div class="imagenizquierda">
