---
const currentPath = Astro.url.pathname;
---

<nav>
    <img src="/Logo-mundial.png" alt="Logo Mundial" class="logo mundial" /> 

    <ul>
        <li>
            <a href="/" class:list={{ active: currentPath === "/" }}>
                Inicio
            </a>
        </li>

        <li>
            <a href="#desafio" class:list={{ active: currentPath === "/mundial" }}>
                EL MUNDIAL
            </a>
        </li>

        <li>
            <a href="#reglamento" class:list={{ active: currentPath === "/reglamento" }}>
                REGLAMENTO
            </a>
        </li>

        <li>
            <a href="#congreso" class:list={{ active: currentPath === "/congreso" }}>
                CONGRESO
            </a>
        </li>

        <li>
            <a href="#novedades" class:list={{ active: currentPath === "/novedades" }}>
                NOVEDADES
            </a>
        </li>
    </ul>
</nav>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    nav {
        width: 100%;
        height: 100px;
        display: flex;
        flex-direction: row;
        justify-content: center;
        align-items: center;
    }

    img {
        width: 77px;
        height: 93px;
        margin-right: 20px;
        margin-left: 50px;
        margin-top: 10px;
    }

    ul {
        width: 100%;
        height: 100px;
        display: flex;
        flex-direction: row;
        justify-content: space-evenly;
        align-items: center;
        margin-right: 20px;
        
    }

    li {
        list-style: none;
        display: inline-block;
        margin: 0 20px;
        
    }

li a {
    display: flex;
    align-items: center;
    height: 100px;
    padding: 0 25px;

    text-decoration: none;
    color: black;
    font-size: 20px;
    font-weight: 500;

        display: flex;
    align-items: center;
    justify-content: center;
}

li a.active {
    width: 144px;
    height: 40px;
    border-radius: 16px;
    background-color: #0D2547;
    color: white;
    font-weight: 900;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.8);
}
</style>