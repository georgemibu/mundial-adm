<script>
    const fechaEvento = new Date("2026-11-05T00:00:00-03:00");

    function actualizarContador() {
        const ahora = new Date();
        const diferencia = fechaEvento.getTime() - ahora.getTime();

        const dias = Math.ceil(diferencia / (1000 * 60 * 60 * 24));

        const contador = document.getElementById("dias-restantes");

        if (contador) {
            contador.textContent = dias > 0 ? dias.toString() : "0";
        }
    }

    actualizarContador();

    setInterval(actualizarContador, 1000 * 60 * 60);
</script>
